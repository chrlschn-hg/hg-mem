{
  "name": "hg-mem",
  "private": true,
  "version": "0.1.0",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "!server/**/*.test.ts",
    "!server/test-support.ts",
    "!server/tools/**"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/*.test.ts",
    "generate:recipes": "node --import tsx server/tools/generate-recipes.ts",
    "generate:skills": "node ../tools/generate-assets.mjs",
    "check:skills": "node ../tools/check-skills.mjs",
    "generate": "npm run generate:recipes && npm run generate:skills",
    "test:graph": "node --import tsx --test ../tests/graph-model.test.mts"
  },
  "devDependencies": {
    "@getpaseo/client": "0.12.0",
    "@getpaseo/plugin": "0.12.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
